// flash.liamjc.dev: static assets on Cloudflare Workers, same setup as liamjc.dev.
// Deploy from this folder with: npx wrangler deploy
{
  "name": "flash-liamjc-dev",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "flash.liamjc.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
